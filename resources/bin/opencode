#!/usr/bin/env bash
# Add the bundled plugin for this invocation, preserving OpenCode's config layers.
set -euo pipefail

WRAPPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REAL_OPENCODE=""
IFS=: read -ra PATH_DIRS <<< "$PATH"
for dir in "${PATH_DIRS[@]}"; do
    dir="${dir:-.}"
    resolved="$(cd "$dir" 2>/dev/null && pwd -P)" || continue
    [[ "$resolved" == "$WRAPPER_DIR" ]] && continue
    if [[ -f "$dir/opencode" && -x "$dir/opencode" && ! "$dir/opencode" -ef "${BASH_SOURCE[0]}" ]]; then
        REAL_OPENCODE="$resolved/opencode"
        break
    fi
done
if [[ -z "$REAL_OPENCODE" ]]; then
    echo "opencode: command not found" >&2
    exit 127
fi

if [[ -z "${SEANCE_SURFACE_ID:-}" || -z "${SEANCE_WORKSPACE_ID:-}" ||
      -z "${SEANCE_SOCKET_PATH:-}" || "${SEANCE_OPENCODE_HOOKS_DISABLED:-}" == 1 ]]; then
    exec "$REAL_OPENCODE" "$@"
fi

# Remote servers cannot inherit this pane's plugin; management commands should
# not create agent status. --pure deliberately disables external plugins.
for arg in "$@"; do
    case "$arg" in
        -h|--help|-v|--version|--pure|--pure=true|--attach|--attach=*) exec "$REAL_OPENCODE" "$@" ;;
    esac
done
case "${1:-}" in
    completion|acp|mcp|attach|debug|providers|auth|agent|upgrade|uninstall|serve|web|models|stats|export|import|github|session|plugin|plug|db|help)
        exec "$REAL_OPENCODE" "$@" ;;
esac

# Resolve the matching binary from our install prefix (also inside AppImages).
# Do not accidentally call an older seance found on PATH.
SEANCE_OPENCODE_BIN="$WRAPPER_DIR/../../../bin/seance"
PLUGIN="$WRAPPER_DIR/../opencode/seance.mjs"
if [[ ! -x "$SEANCE_OPENCODE_BIN" || ! -r "$PLUGIN" ]] ||
   ! timeout 0.75 "$SEANCE_OPENCODE_BIN" ctl ping >/dev/null 2>&1; then
    exec "$REAL_OPENCODE" "$@"
fi
if ! CONTENT=$("$SEANCE_OPENCODE_BIN" ctl opencode-config "$PLUGIN"); then
    exec "$REAL_OPENCODE" "$@"
fi
export OPENCODE_CONFIG_CONTENT="$CONTENT"
export SEANCE_OPENCODE_BIN
export SEANCE_OPENCODE_PID=$$

# EXIT runs for successful exits and startup failures alike. Never mask the
# agent's exit status or leak hook output into the terminal/JSON stream.
trap 'timeout 3 "$SEANCE_OPENCODE_BIN" ctl opencode-hook session-end <<< "{}" >/dev/null 2>&1 || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
rc=0
"$REAL_OPENCODE" "$@" || rc=$?
exit "$rc"
